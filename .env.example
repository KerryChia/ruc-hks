# Use a dedicated database and keep the real .env.local out of source control.
DATABASE_URL=postgresql://examhub:replace-me@127.0.0.1:5432/examhub
# Generate: node -p "require('node:crypto').randomBytes(32).toString('base64')"
# Keep the same key across builds and include it in secure disaster recovery.
ANSWER_KEY=
# 0 only for local HTTP / SSH tunnels; set to 1 behind HTTPS.
SECURE_COOKIES=0
ENABLE_PAYMENT_SANDBOX=0
NEXT_TELEMETRY_DISABLED=1
# Optional. Defaults to /var/lib/examhub/resources; keep course files outside release directories.
RESOURCE_DIR=/var/lib/examhub/resources
# Optional; leave blank to use the operator-issued invitations.
SMTP_URL=
SMTP_FROM=
EMAIL_CODE_SECRET=
# AI review. Server-side only: never expose these with NEXT_PUBLIC_ and never commit real values.
AI_API_BASE=
AI_API_KEY=
# Must be one of the two approved models.
AI_MODEL=
AI_TIMEOUT_MS=45000
# Tokens the site gives away before falling back to CC pricing.
FREE_TOKEN_POOL=1000000000
AI_DAILY_LIMIT=20
# Optional, set to the exact HTTPS origin for browser-based MCP clients.
EXAMHUB_MCP_ORIGIN=
# Optional public origin used when generating invite links.
EXAMHUB_PUBLIC_ORIGIN=
